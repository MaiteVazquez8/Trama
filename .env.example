# Trama - Variables de entorno para el frontend (Vue + Vite)
# Copiá este archivo a .env y completá los valores de tu proyecto de Supabase.
# Nunca subas el archivo .env con valores reales al repositorio.

# URL del proyecto de Supabase (ej: https://abcdefghijklmnop.supabase.co)
VITE_SUPABASE_URL=

# Clave pública anon key de Supabase (solo para cliente, nunca service_role)
VITE_SUPABASE_ANON_KEY=
